{
  "buildCommand": "npm install --prefix /tmp/gh-browser --no-audit --no-fund @sparticuz/chromium@158.0.0 && env -i PATH=\"$PATH\" HOME=\"$HOME\" CI=1 TZ=UTC ./node_modules/.bin/playwright test -c playwright.release-check.mts --reporter=list && npm run build",
  "crons": [
    {
      "path": "/api/auto-charge",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/auto-charge",
      "schedule": "0 22 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/save-card",
      "destination": "/cabinet.html"
    },
    {
      "source": "/cleaner",
      "destination": "/cabinet.html"
    },
    {
      "source": "/owner",
      "destination": "/cabinet.html"
    },
    {
      "source": "/report",
      "destination": "/cabinet.html"
    },
    {
      "source": "/visit",
      "destination": "/cabinet.html"
    },
    {
      "source": "/areas/:city",
      "destination": "/"
    },
    {
      "source": "/(.*)",
      "destination": "/api/owner-auth?notfound=1"
    }
  ],
  "functions": {
    "api/visit.ts": {
      "maxDuration": 60
    },
    "api/send-contact-email.ts": {
      "maxDuration": 40
    },
    "api/create-checkout-session.ts": {
      "maxDuration": 40
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/founding",
      "destination": "/quote",
      "permanent": true
    },
    {
      "source": "/reviews",
      "destination": "/quote",
      "permanent": true
    },
    {
      "source": "/gallery",
      "destination": "/quote",
      "permanent": true
    },
    {
      "source": "/availability",
      "destination": "/quote",
      "permanent": true
    },
    {
      "source": "/services/standard-cleaning",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/deep-cleaning",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/move-in-out-cleaning",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/recurring-plans",
      "destination": "/services",
      "permanent": true
    }
  ]
}
