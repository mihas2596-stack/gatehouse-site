{
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/auto-charge",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/auto-charge",
      "schedule": "0 22 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/save-card",
      "destination": "/"
    },
    {
      "source": "/cleaner",
      "destination": "/"
    },
    {
      "source": "/owner",
      "destination": "/"
    },
    {
      "source": "/report",
      "destination": "/"
    },
    {
      "source": "/visit",
      "destination": "/"
    },
    {
      "source": "/areas/:city",
      "destination": "/"
    },
    {
      "source": "/(.*)",
      "destination": "/api/not-found"
    }
  ],
  "functions": {
    "api/send-contact-email.ts": {
      "maxDuration": 40
    },
    "api/create-checkout-session.ts": {
      "maxDuration": 40
    }
  },
  "redirects": [
    {
      "source": "/founding",
      "destination": "/quote",
      "permanent": true
    },
    {
      "source": "/reviews",
      "destination": "/quote",
      "permanent": true
    },
    {
      "source": "/gallery",
      "destination": "/quote",
      "permanent": true
    },
    {
      "source": "/availability",
      "destination": "/quote",
      "permanent": true
    },
    {
      "source": "/services/standard-cleaning",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/deep-cleaning",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/move-in-out-cleaning",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/recurring-plans",
      "destination": "/services",
      "permanent": true
    }
  ]
}
