{
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/auto-charge",
      "schedule": "0 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "functions": {
    "api/send-contact-email.ts": {
      "maxDuration": 40
    },
    "api/create-checkout-session.ts": {
      "maxDuration": 40
    }
  }
}
